within HVAC.PsychrometricUtils;
package Test
  model Test_Dew_f_Tdrybulb_RH
    PsychrometricUtils.Dew_f_Tdrybulb_RH dew_f_Tdrybulb_RH
      annotation (Placement(transformation(extent={{-16,-38},{60,34}})));
    Modelica.Blocks.Sources.Constant Tdb_C(k=25)
      annotation (Placement(transformation(extent={{-88,38},{-68,58}})));
    Modelica.Blocks.Sources.Constant Kelvin(k=273.15)
      annotation (Placement(transformation(extent={{-58,76},{-42,92}})));
    Modelica.Blocks.Math.Add add
      annotation (Placement(transformation(extent={{-48,38},{-28,58}})));
    Modelica.Blocks.Sources.Constant RH_100(k=60)
      annotation (Placement(transformation(extent={{-84,-42},{-64,-22}})));
    Modelica.Blocks.Math.Gain gain(k=0.01)
      annotation (Placement(transformation(extent={{-50,-40},{-36,-26}})));
  equation
    connect(Kelvin.y, add.u1) annotation (Line(points={{-41.2,84},{-30,84},{
            -30,62},{-56,62},{-56,54},{-50,54}}, color={0,0,127}));
    connect(Tdb_C.y, add.u2) annotation (Line(points={{-67,48},{-58,48},{-58,
            42},{-50,42}}, color={0,0,127}));
    connect(add.y, dew_f_Tdrybulb_RH.TDryBulb) annotation (Line(points={{-27,
            48},{-20,48},{-20,26},{-28,26},{-28,19.6},{-20.56,19.6}}, color={
            0,0,127}));
    connect(RH_100.y, gain.u)
      annotation (Line(points={{-63,-32},{-51.4,-33}}, color={0,0,127}));
    connect(gain.y, dew_f_Tdrybulb_RH.RelHum) annotation (Line(points={{-35.3,
            -33},{-28,-33},{-28,-23.6},{-20.56,-23.6}}, color={0,0,127}));
    annotation (Icon(coordinateSystem(preserveAspectRatio=false)), Diagram(
          coordinateSystem(preserveAspectRatio=false)));
  end Test_Dew_f_Tdrybulb_RH;
end Test;

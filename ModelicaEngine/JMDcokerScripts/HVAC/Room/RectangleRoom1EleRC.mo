  connect(OAT, eqAirTemp.TDryBul) annotation (
    Line(points = {{-107, 93}, {-68, 93}, {-68, -28}, {8, -28}, {8, -24}, {48, -24}, {48, -54}, {66, -54}}, color = {0, 0, 127}));
  connect(PeopleSensGainPerPerson.y, perCon.Q_flow) annotation (
    Line(points = {{-17.6, -200}, {-8, -200}, {-8, -204}, {2, -204}}, color = {0, 0, 127}));
  connect(PeopleSensGainPerPerson.y, PeopleRadFract.u) annotation (
    Line(points = {{-17.6, -200}, {-16, -200}, {-16, -190}, {-26, -190}, {-26, -184}, {-14.8, -184}}, color = {0, 0, 127}));
  connect(PeopleRadFract.y, perRad.Q_flow) annotation (

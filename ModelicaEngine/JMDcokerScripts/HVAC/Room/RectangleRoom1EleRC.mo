  connect(gain.y, TBlaSkyCom.nOpa) annotation (
    Line(points = {{-73.6, 16}, {-10, 16}, {-10, -51}, {12, -51}}, color = {0, 0, 127}));
  connect(OAT, dew_f_Tdrybulb_RH.TDryBulb) annotation (
    Line(points = {{-107, 93}, {-74, 93}, {-74, 69.2}, {-70.96, 69.2}}, color = {0, 0, 127}));
  connect(OARH, dew_f_Tdrybulb_RH.RelHum) annotation (
    Line(points = {{-107, 53}, {-107, 60.8}, {-70.96, 60.8}}, color = {0, 0, 127}));
  connect(dew_f_Tdrybulb_RH.DewPoi, TBlaSkyCom.TDewPoi) annotation (
    Line(points = {{-53.2, 65}, {-48, 65}, {-48, 28}, {-46, 28}, {-46, -45}, {12, -45}}, color = {0, 0, 127}));
  connect(OAT, TBlaSkyCom.TDryBul) annotation (
    Line(points = {{-107, 93}, {-74, 93}, {-74, 34}, {-54, 34}, {-54, -30}, {12, -30}, {12, -40}}, color = {0, 0, 127}));
  connect(OAT, HorInfRad.TDryBul) annotation (
    Line(points = {{-107, 93}, {-74, 93}, {-74, 34}, {-54, 34}, {-54, -30}, {-29.2, -30}, {-29.2, -61.2}}, color = {0, 0, 127}));
  connect(HorInfRad.TDewPoi, dew_f_Tdrybulb_RH.DewPoi) annotation (

within HVAC.Room;
model RectangleRoom1EleRC
"A rectangle-shaped room using one element RC model"
parameter Integer nPorts=0 "Number of fluid ports"
    annotation(Evaluate=true,
    Dialog(connectorSizing=true, tab="General",group="Ports"));
  parameter Modelica.SIunits.Time TimeZone(
    displayUnit="h")
                    "Time zone; e.g., Beijing is +8*3600"
                    annotation (Dialog(group="Location"));
  parameter Modelica.SIunits.Angle Lat(
    displayUnit="deg")
                      "Latitude"
                      annotation (Dialog(group="Location"));
  parameter Modelica.SIunits.Angle Lon(
    displayUnit="deg")
                      "Longitude"
                      annotation (Dialog(group="Location"));
  parameter Modelica.SIunits.Angle UpperAzi(
    displayUnit="deg")
    "Surface azimuth angle (north is zero, clockwise) of the upper surface"
    annotation (Dialog(group="Room geometry"));
  parameter Modelica.SIunits.Length RoomHeight
  "Room height"
  annotation (Dialog(group="Room geometry"));
  parameter Modelica.SIunits.Length HorizontalLength
  "Length of the upper and lower surface"
  annotation (Dialog(group="Room geometry"));
  parameter Modelica.SIunits.Length VerticalLength
  "Length of the left and right surface"
  annotation (Dialog(group="Room geometry"));
  parameter Boolean UpperFaceOutside
    "Does the upper surface face outside environment"
     annotation (Dialog(group="Room geometry"));
  parameter Boolean LowerFaceOutside
    "Does lower surface face outside environment"
     annotation (Dialog(group="Room geometry"));
  parameter Boolean LeftFaceOutside
    "Does left surface face outside environment"
     annotation (Dialog(group="Room geometry"));
  parameter Boolean RightFaceOutside
    "Does right surface face outside environment"
     annotation (Dialog(group="Room geometry"));
  parameter Real UpperSurfaceWWR=0.3
  "Upper surface window to wall ratio (WWR)"
  annotation (Dialog(group="Thermal property"));
  parameter Real LowerSurfaceWWR=0.3
  "Lower surface window to wall ratio (WWR)"
  annotation (Dialog(group="Thermal property"));
  parameter Real LeftSurfaceWWR=0.3
  "Left surface window to wall ratio (WWR)"
  annotation (Dialog(group="Thermal property"));
  parameter Real RightSurfaceWWR=0.3
  "Right surface window to wall ratio (WWR)"
  annotation (Dialog(group="Thermal property"));
  parameter Real UWin(unit="W/m2.K")
  "Thermal transmittance (U-value) of window"
  annotation (Dialog(group="Thermal property"));
  parameter Real UWall(unit="W/m2.K")
  "Thermal transmittance (U-value) of wall"
  annotation (Dialog(group="Thermal property"));
  parameter Modelica.SIunits.TransmissionCoefficient GWin
  "Total energy transmittance coefficient of window"
  annotation (Dialog(group="Thermal property"));
  parameter Real CWallPerArea(unit="J/K.m2")
  "Heat capacity of wall per unit wall area"
  annotation (Dialog(group="Thermal property"));
  parameter Modelica.SIunits.ThermodynamicTemperature InitTDryBulb(displayUnit="degC")
  "Initial indoor dry bulb air temperature"
  annotation (Dialog(group="Initial condition"));
  parameter Real InitRH(unit="1")
  "Initial indoor relative humidity"
  annotation (Dialog(group="Initial condition"));
  parameter Boolean UseInputInfiltrationRate
  "Use input infiltration rate"
  annotation(Evaluate=true, HideResult=true, Dialog(group="Infiltration"));
  parameter Real ConstantInfiltrationRate(unit="ACH")
  "Constant  infiltration rate in ACH if UseInputInfiltrationRate is false"
  annotation (Dialog(enable = not UseInputInfiltrationRate,group="Infiltration"));
  parameter Integer nOrientation = HVAC.Room.Utils.getOrientationN(UpperFaceOutside, LowerFaceOutside, LeftFaceOutside, RightFaceOutside)
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Real WallsAreaVector[nOrientation] = HVAC.Room.Utils.getWallsArea(UpperFaceOutside, LowerFaceOutside, LeftFaceOutside, RightFaceOutside, UpperSurfaceWWR, LowerSurfaceWWR, LeftSurfaceWWR, RightSurfaceWWR, nOrientation, RoomHeight, HorizontalLength, VerticalLength)
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Real WinsAreaVector[nOrientation] = HVAC.Room.Utils.getWinsArea(UpperFaceOutside, LowerFaceOutside, LeftFaceOutside, RightFaceOutside, UpperSurfaceWWR, LowerSurfaceWWR, LeftSurfaceWWR, RightSurfaceWWR, nOrientation, RoomHeight, HorizontalLength, VerticalLength)
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Modelica.SIunits.Angle WallsAziVector[nOrientation] = HVAC.Room.Utils.getWallsAzi(UpperFaceOutside, LowerFaceOutside, LeftFaceOutside, RightFaceOutside, nOrientation, UpperAzi)
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Modelica.SIunits.ThermalResistance RWallWin[2] = HVAC.Room.Utils.getWallWinThermalResistance(UpperFaceOutside, LowerFaceOutside, LeftFaceOutside, RightFaceOutside, UpperSurfaceWWR, LowerSurfaceWWR, LeftSurfaceWWR, RightSurfaceWWR, RoomHeight, HorizontalLength, VerticalLength, UWall, UWin) "Thermal resistance of wall and window"
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Modelica.SIunits.ThermalResistance RWall = RWallWin[1] "Thermal resistance of wall"
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Modelica.SIunits.ThermalResistance RWin = RWallWin[2] "Thermal resistance of window"
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Modelica.SIunits.HeatCapacity CWall = HVAC.Room.Utils.getWallCapacity(UpperFaceOutside, LowerFaceOutside, LeftFaceOutside, RightFaceOutside, UpperSurfaceWWR, LowerSurfaceWWR, LeftSurfaceWWR, RightSurfaceWWR, RoomHeight, HorizontalLength, VerticalLength, CWallPerArea)
                                                        "Capacitance of wall"
                                                        annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Real WFWallWin[2,nOrientation] = HVAC.Room.Utils.getWeightFactors(UpperFaceOutside, LowerFaceOutside, LeftFaceOutside, RightFaceOutside, UpperSurfaceWWR, LowerSurfaceWWR, LeftSurfaceWWR, RightSurfaceWWR, nOrientation, RoomHeight, HorizontalLength, VerticalLength, UWall, UWin)
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Real WFWall[nOrientation] = WFWallWin[1]
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Real WFWin[nOrientation] = WFWallWin[2]
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Real InitSteamMassFrac(unit="1")=
    HVAC.PsychrometricUtils.Functions.getSteamMassFracFromTDrybulbRH(
    InitTDryBulb, InitRH)                 "Initial indoor steam mass fraction ratio"
    annotation (Dialog(group="Derived (normally DO NOT modify)"));
  parameter Real InitX[2] = {InitSteamMassFrac, 1-InitSteamMassFrac}
  annotation (Dialog(group="Derived (normally DO NOT modify)"));
  Buildings.ThermalZones.ReducedOrder.RC.OneElement thermalZoneOneElement(
    redeclare package Medium = Buildings.Media.Air,
    AExt=WallsAreaVector,
    ATransparent=WinsAreaVector,
    AWin=WinsAreaVector,
    CExt={CWall},
    RExt={RWall},
    RExtRem=0.1265217391,
    RWin=RWin,
    T_start(displayUnit="K") = InitTDryBulb,
    VAir=RoomHeight*HorizontalLength*HorizontalLength,
    X_start = InitX,
    energyDynamics=Modelica.Fluid.Types.Dynamics.FixedInitial,
    extWallRC(thermCapExt(der_T(each fixed = true))),
    gWin=GWin,
    hConExt=2.7,
    hConWin=2.7,
    hRad=5,
    nExt=1,
    nOrientations=nOrientation,
    ratioWinConRad=0.09,
    use_moisture_balance= true,
    nPorts=2+nPorts)                "Thermal zone"
    annotation (Placement(transformation(extent={{174,16},{222,52}})));

  Buildings.ThermalZones.ReducedOrder.EquivalentAirTemperature.VDI6007WithWindow
                                             eqAirTemp(
    n=nOrientation,
    wfGro=0,
    wfWall=WFWall,
    wfWin=WFWin,
    withLongwave=true,
    aExt=0.7,
    hConWallOut=20,
    hRad=5,
    hConWinOut=20,
    TGro=InitTDryBulb)
                 "Computes equivalent air temperature"
    annotation (Placement(transformation(extent={{68,-58},{88,-38}})));
  Buildings.HeatTransfer.Sources.PrescribedTemperature preTem
    "Prescribed temperature for exterior walls outdoor surface temperature"
    annotation (Placement(transformation(extent={{100,-50},{112,-38}})));
  Buildings.HeatTransfer.Sources.PrescribedTemperature preTem1
    "Prescribed temperature for windows outdoor surface temperature"
    annotation (Placement(transformation(extent={{100,-30},{112,-18}})));
  Modelica.Thermal.HeatTransfer.Components.Convection theConWin
    "Outdoor convective heat transfer of windows"
    annotation (Placement(transformation(extent={{130,-28},{120,-18}})));
  Modelica.Thermal.HeatTransfer.Components.Convection theConWall
    "Outdoor convective heat transfer of walls"
    annotation (Placement(transformation(extent={{128,-38},{118,-48}})));
  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow perRad
    "Radiative heat flow of persons"
    annotation (Placement(transformation(extent={{2,-194},{22,-174}})));
  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow perCon
    "Convective heat flow of persons"
    annotation (Placement(transformation(extent={{2,-214},{22,-194}})));
  Modelica.Blocks.Sources.Constant const[2](each k=0)
    "Sets sunblind signal to zero (open)"
    annotation (Placement(transformation(extent={{62,-28},{68,-22}})));
  Modelica.Thermal.HeatTransfer.Sources.PrescribedHeatFlow macConv
    "Convective heat flow of machines"
    annotation (Placement(transformation(extent={{2,-236},{22,-216}})));
  Modelica.Blocks.Sources.Constant hConWall(k=25*11.5)
    "Outdoor coefficient of heat transfer for walls"
    annotation (Placement(
    transformation(
    extent={{-4,-4},{4,4}},
    rotation=90,
    origin={122,-60})));
  Modelica.Blocks.Sources.Constant hConWin(k=20*14)
    "Outdoor coefficient of heat transfer for windows"
    annotation (Placement(
    transformation(
    extent={{4,-4},{-4,4}},
    rotation=90,
    origin={124,-6})));
  Modelica.Blocks.Interfaces.RealInput OAT(
    final quantity="ThermodynamicTemperature",
    final unit="K",
    displayUnit="degC") "Outdoor air dry bulb temperature"
                                       annotation (Placement(transformation(
          extent={{-13,-13},{13,13}}, origin={-107,93}),
                                         iconTransformation(extent={{-127,75},{-101,
            101}})));
  Modelica.Blocks.Interfaces.RealInput OARH(min=0, max=1, unit="1")
    "Outdoor air relative humidity"         annotation (Placement(
        transformation(extent={{-13,-13},{13,13}}, origin={-107,53}),
                                                      iconTransformation(extent={{-127,23},
            {-101,49}})));
  Modelica.Blocks.Interfaces.RealInput SkyCoverTenths(min=0, max=10)
    "Opaque sky cover in tenths (0-10, 0 is clear sky, 10 is completely overcast)"
    annotation (Placement(transformation(extent={{-13,-13},{13,13}}, origin={-107,13}),
        iconTransformation(extent={{-127,-27},{-101,-1}})));
  Modelica.Blocks.Interfaces.RealInput SolDirNorm(final quantity="RadiantEnergyFluenceRate",
    final unit="W/m2")
    "Direct normal solar radiation per unit area" annotation (Placement(
        visible = true,transformation(origin={-107,-27},   extent={{-13,-13},{
            13,13}},                                                                   rotation = 0),
                                                     iconTransformation(extent={{-127,
            -79},{-101,-53}},                                                                                 rotation = 0)));
  Modelica.Blocks.Math.Gain gain(k=0.1)
    annotation (Placement(transformation(extent={{-82,12},{-74,20}})));
  PsychrometricUtils.Dew_f_Tdrybulb_RH dew_f_Tdrybulb_RH
    annotation (Placement(transformation(extent={{-70,58},{-54,72}})));
  WeatherUtils.HorInfRad HorInfRad
    annotation (Placement(transformation(extent={{-28,-72},{-16,-60}})));
  Modelica.Blocks.Interfaces.RealInput nPeople
    "The number of people in the room, used to calculate sensible and latent heat gain"
    annotation (Placement(transformation(extent={{-13,-13},{13,13}}, origin={-107,
            -187}),
        iconTransformation(extent={{-127,-181},{-101,-155}})));
  Modelica.Blocks.Math.Gain PeopleSensGainPerPerson(k= 75)
    "Sensible heat gain per person(W)"
    annotation (Placement(transformation(extent={{-26,-204},{-18,-196}})));
  Modelica.Blocks.Math.Gain PeopleRadFract(k= 0.3)
    "Fraction of radiant heat emitted by people (0-1)"
    annotation (Placement(transformation(extent={{-14,-188},{-6,-180}})));
  Modelica.Blocks.Interfaces.RealInput EquipGain(final quantity="Power",
    final unit="W") "Internal heat gain from equipment"
                                        annotation (Placement(
        transformation(extent={{-13,-13},{13,13}}, origin={-107,-227}),
                                                       iconTransformation(
          extent={{-127,-235},{-101,-209}})));
  Modelica.Blocks.Math.Gain PeopleLatGainPerPerson(k=40)
    "Latent heat gain per person(W)"
    annotation (Placement(transformation(extent={{160,18},{168,26}})));

  WeatherUtils.DirectTitledSurface_f_CloTime directTitledSurface_f_CloTime[nOrientation](
    each timZon=TimeZone,
    each lon=Lon,
    each lat=Lat,
    azi=WallsAziVector,
    each til=1.57079633)
    annotation (Placement(transformation(extent={{38,66},{60,88}})));
  Modelica.Blocks.Interfaces.RealOutput IAT(
    final quantity="ThermodynamicTemperature",
    final unit="K",
    displayUnit="degC")
    "Indoor air dry bulb temperature"
    annotation (Placement(transformation(extent={{340,60},{360,80}}),
        iconTransformation(extent={{340,60},{360,80}})));
  Modelica.Blocks.Interfaces.RealOutput IRT(
    final quantity="ThermodynamicTemperature",
    final unit="K",
    displayUnit="degC") "Indoor radiant temperature"
    annotation (Placement(transformation(extent={{340,30},{360,50}}),
        iconTransformation(extent={{340,30},{360,50}})));
  Modelica.Blocks.Routing.Replicator replicator(nout = nOrientation)  annotation (
    Placement(visible = true, transformation(origin={-20,82},    extent = {{-4, -4}, {4, 4}}, rotation = 0)));
  Modelica.Blocks.Routing.Replicator replicator1(nout = nOrientation) annotation (
    Placement(visible = true, transformation(origin={-18,70},    extent = {{-4, -4}, {4, 4}}, rotation = 0)));
  Modelica.Blocks.Interfaces.RealInput SolDifHori(quantity = "RadiantEnergyFluenceRate", unit = "W/m2") "Diffuse horizontal solar radiation per unit area" annotation (
    Placement(visible = true, transformation(origin={-107,-67},     extent={{-13,-13},
            {13,13}},                                                                                rotation = 0), iconTransformation(extent={{-127,
            -131},{-101,-105}},                                                                                                                                              rotation = 0)));
  WeatherUtils.DiffuseTitledSurface_f_CloTime diffuseTitledSurface_f_CloTime[
    nOrientation](
    each timZon=TimeZone,
    each lon=Lon,
    each lat=Lat,
    azi=WallsAziVector,
    each til=1.57079633,
    each OutputHSkyDifTil=true,
    each OutputHGroDifTil=true)
    annotation (Placement(transformation(extent={{38,26},{60,48}})));
  WeatherUtils.SolGloHori_f_SolDirNormSolDifHori
    solGloHori_f_SolDirNormSolDifHori(
    timZon=TimeZone,
    lon=Lon,
    lat=Lat) annotation (Placement(transformation(extent={{-10,34},{10,54}})));
  Modelica.Blocks.Routing.Replicator replicator2(nout=nOrientation)   annotation (
    Placement(visible = true, transformation(origin={20,44},     extent = {{-4, -4}, {4, 4}}, rotation = 0)));
  Modelica.Blocks.Routing.Replicator replicator3(nout=nOrientation)   annotation (
    Placement(visible = true, transformation(origin={20,34},     extent = {{-4, -4}, {4, 4}}, rotation = 0)));
  Modelica.Blocks.Routing.Replicator replicator4(nout=nOrientation)   annotation (
    Placement(visible = true, transformation(origin={18,20},     extent = {{-4, -4}, {4, 4}}, rotation = 0)));
  Modelica.Blocks.Math.Add solRad[nOrientation]
    "Sums up solar radiation of both directions"
    annotation (Placement(transformation(extent={{84,46},{94,56}})));
  Modelica.Blocks.Interfaces.RealOutput IRH(
    final quantity="1",
    final unit="1") "Indoor relative humidity" annotation (Placement(
        transformation(extent={{340,30},{360,50}}), iconTransformation(extent={{340,0},
            {360,20}})));
  Buildings.Utilities.Psychrometrics.Phi_pTX phi
    annotation (Placement(transformation(extent={{312,26},{322,36}})));
  Modelica.Blocks.Sources.RealExpression volMoiAir_X_w(y=thermalZoneOneElement.volMoiAir.X_w)
    annotation (Placement(transformation(extent={{258,22},{278,42}})));
  Modelica.Blocks.Sources.Constant air_pressure(k=101320)
    "Default air pressure (Pa)"
    annotation (Placement(transformation(extent={{264,16},{272,24}})));
  Buildings.Fluid.Sources.MassFlowSource_T OutdoorAir(
    redeclare package Medium = Buildings.Media.Air,
    m_flow=ConstantInfiltrationRate*1.293*RoomHeight*HorizontalLength*
        HorizontalLength/3600,
    nPorts= 1,
    use_C_in=false,
    use_T_in=true, use_X_in = false,
    use_Xi_in= true,
    use_m_flow_in= UseInputInfiltrationRate)
    annotation (Placement(visible = true, transformation(extent={{-10,-10},{10,
            10}},                                                                             rotation=90,
        origin={208,-152})));
  Buildings.Utilities.Psychrometrics.X_pTphi x_pTphi(use_p_in=false)
    annotation (Placement(transformation(extent={{158,-198},{172,-184}})));
  Modelica.Blocks.Interfaces.RealInput InputInfiltration(final quantity="ACH",
      final unit="1") if UseInputInfiltrationRate "Input infiltration rate" annotation (Placement(
        transformation(
        extent={{-13,-13},{13,13}},
        origin={201,-253},
        rotation=90), iconTransformation(extent={{-13,-13},{13,13}},
        rotation=90,
        origin={-32,-252})));

   Modelica.Blocks.Math.Gain ACH2MassFlow(k=1.293*RoomHeight*HorizontalLength*
        HorizontalLength/3600) if UseInputInfiltrationRate "Convert ACH to mass flow rate"
    annotation (Placement(transformation(extent={{208,-224},{220,-212}})));
  Buildings.Fluid.Sources.Boundary_pT pAtm(redeclare package Medium =
        Buildings.Media.Air, nPorts=1)  "OutdoorAir condition"
    annotation (Placement(transformation(extent={{-10,-10},{10,10}},
        rotation=180,
        origin={254,-154})));
  Modelica.Fluid.Vessels.BaseClasses.VesselFluidPorts_b RoomPorts[nPorts](
      redeclare each final package Medium = Modelica.Media.Air.MoistAir)
    "AC air input port" annotation (Placement(transformation(extent={{-45,-12},{
            45,12}}, origin={279,-242}), iconTransformation(extent={{-30.5,-8},{
            30.5,8}}, origin={132,-239.5})));
  Buildings.ThermalZones.ReducedOrder.SolarGain.CorrectionGDoublePane
                                  corGDouPan(n=nOrientation, UWin=UWin)
    "Correction factor for solar transmission"
    annotation (Placement(transformation(extent={{110,62},{130,82}})));
  WeatherUtils.IncidenceAngle_f_CloTime[nOrientation]
                           incidenceAngle_f_CloTime(
    each final timZon=TimeZone,
    each final lon=Lon,
    each final lat=Lat,
    final azi=WallsAziVector,
    each final til=1.57079633)
    annotation (Placement(transformation(extent={{-10,84},{2,96}})));
  Modelica.Blocks.Routing.Replicator replicator5(nout = nOrientation) annotation (
    Placement(visible = true, transformation(origin = {-27, 93}, extent = {{-3, -3}, {3, 3}}, rotation = 0)));
protected
  Buildings.BoundaryConditions.SkyTemperature.BlackBody
                           TBlaSkyCom(calTSky = Buildings.BoundaryConditions.Types.SkyTemperatureCalculation.TemperaturesAndSkyCover)
    "Computation of the black-body sky temperature"
    annotation (Placement(transformation(extent={{14,-58},{34,-38}})));
  Buildings.Utilities.Time.ModelTime modTim "Model time"
    annotation (Placement(transformation(extent={{-72,76},{-52,96}})));
equation
  connect(eqAirTemp.TEqAirWin, preTem1.T) annotation (
    Line(points = {{89, -44.2}, {92, -44.2}, {92, -24}, {98.8, -24}}, color = {0, 0, 127}));
  connect(eqAirTemp.TEqAir, preTem.T) annotation (
    Line(points = {{89, -48}, {96, -48}, {96, -44}, {98.8, -44}}, color = {0, 0, 127}));
  connect(const.y, eqAirTemp.sunblind) annotation (
    Line(points = {{68.3, -25}, {78, -25}, {78, -36}}, color = {0, 0, 127}));
  connect(perRad.port, thermalZoneOneElement.intGainsRad) annotation (
    Line(points = {{22, -184}, {100, -184}, {100, 42}, {222, 42}}, color = {191, 0, 0}));
  connect(theConWin.solid, thermalZoneOneElement.window) annotation (
    Line(points = {{130, -23}, {130, 38}, {174, 38}}, color = {191, 0, 0}));
  connect(preTem1.port, theConWin.fluid) annotation (
    Line(points = {{112, -24}, {120, -24}, {120, -23}}, color = {191, 0, 0}));
  connect(thermalZoneOneElement.extWall, theConWall.solid) annotation (
    Line(points = {{174, 30}, {136, 30}, {136, -43}, {128, -43}}, color = {191, 0, 0}));
  connect(theConWall.fluid, preTem.port) annotation (
    Line(points = {{118, -43}, {116, -43}, {116, -44}, {112, -44}}, color = {191, 0, 0}));
  connect(hConWall.y, theConWall.Gc) annotation (
